{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "fin",
	"scopeName": "source.fin",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#annotations" },
		{ "include": "#include" },
		{ "include": "#virtual" },
		{ "include": "#price" },
		{ "include": "#dated-directive" },
		{ "include": "#quoted-transaction" },
		{ "include": "#grouped-transaction" },
		{ "include": "#arrow-line" },
		{ "include": "#booking-line" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.number-sign.fin",
					"match": "^(#).*$",
					"captures": {
						"1": { "name": "punctuation.definition.comment.fin" }
					}
				},
				{
					"name": "comment.line.double-slash.fin",
					"match": "^(//).*$",
					"captures": {
						"1": { "name": "punctuation.definition.comment.fin" }
					}
				},
				{
					"name": "comment.line.asterisk.fin",
					"match": "^(\\*+)(.*)$",
					"captures": {
						"1": { "name": "punctuation.definition.comment.fin" },
						"2": { "name": "markup.heading.fin" }
					}
				}
			]
		},
		"annotations": {
			"patterns": [
				{
					"name": "meta.annotation.performance.fin",
					"begin": "^(@)(performance)[ \\t]*(\\()",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.annotation.fin" },
						"2": { "name": "entity.name.function.decorator.fin" },
						"3": { "name": "punctuation.section.parens.begin.fin" }
					},
					"end": "(\\))|$",
					"endCaptures": {
						"1": { "name": "punctuation.section.parens.end.fin" }
					},
					"patterns": [
						{ "include": "#commodity" },
						{
							"name": "punctuation.separator.comma.fin",
							"match": ","
						}
					]
				},
				{
					"name": "meta.annotation.accrual.fin",
					"begin": "^(@)(accrue)\\b",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.annotation.fin" },
						"2": { "name": "entity.name.function.decorator.fin" }
					},
					"end": "$",
					"patterns": [
						{
							"name": "constant.language.interval.fin",
							"match": "\\b(once|daily|weekly|monthly|quarterly|yearly)\\b"
						},
						{ "include": "#date" },
						{ "include": "#account" }
					]
				}
			]
		},
		"include": {
			"name": "meta.directive.include.fin",
			"begin": "^(include)\\b",
			"beginCaptures": {
				"1": { "name": "keyword.control.directive.fin" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#string" }
			]
		},
		"virtual": {
			"name": "meta.directive.virtual.fin",
			"begin": "^(virtual)[ \\t]+((Assets|Liabilities|Equity|Income|Expenses)(?::[\\p{L}\\p{N}]+)*)",
			"beginCaptures": {
				"1": { "name": "keyword.control.directive.fin" },
				"2": { "name": "entity.name.type.account.fin" },
				"3": { "name": "support.class.account-type.fin" }
			},
			"end": "^(?![\\p{L}\\p{N}])",
			"patterns": [
				{
					"name": "string.regexp.fin",
					"match": "^\\S+"
				}
			]
		},
		"price": {
			"name": "meta.directive.price.fin",
			"match": "^(\\d{4}-\\d{2}-\\d{2})[ \\t]+(price)[ \\t]+([\\p{L}\\p{N}]+)[ \\t]+(-?\\d+(?:\\.\\d+)?)[ \\t]+([\\p{L}\\p{N}]+)",
			"captures": {
				"1": { "name": "constant.numeric.date.fin" },
				"2": { "name": "keyword.control.directive.fin" },
				"3": { "name": "support.type.commodity.fin" },
				"4": { "name": "constant.numeric.fin" },
				"5": { "name": "support.type.commodity.fin" }
			}
		},
		"dated-directive": {
			"name": "meta.directive.fin",
			"begin": "^(\\d{4}-\\d{2}-\\d{2})[ \\t]+(open|close|balance)\\b",
			"beginCaptures": {
				"1": { "name": "constant.numeric.date.fin" },
				"2": { "name": "keyword.control.directive.fin" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#account" },
				{ "include": "#amount" }
			]
		},
		"quoted-transaction": {
			"name": "meta.transaction.fin",
			"begin": "^(\\d{4}-\\d{2}-\\d{2})[ \\t]+(?=\")",
			"beginCaptures": {
				"1": { "name": "constant.numeric.date.fin" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#string" }
			]
		},
		"grouped-transaction": {
			"name": "meta.transaction.description.fin",
			"begin": "^(\\d{4}-\\d{2}-\\d{2})[ \\t]*$",
			"beginCaptures": {
				"1": { "name": "constant.numeric.date.fin" }
			},
			"end": "^(?=[^ \\t])",
			"patterns": [
				{
					"name": "string.unquoted.description.fin",
					"match": "^[ \\t]+\\S.*$"
				}
			]
		},
		"arrow-line": {
			"name": "meta.booking.fin",
			"begin": "^(->|<-)",
			"beginCaptures": {
				"1": { "name": "keyword.operator.arrow.fin" }
			},
			"end": "$",
			"patterns": [
				{ "include": "#account" },
				{ "include": "#amount" }
			]
		},
		"booking-line": {
			"name": "meta.booking.fin",
			"begin": "^(?=(Assets|Liabilities|Equity|Income|Expenses)\\b)",
			"end": "$",
			"patterns": [
				{ "include": "#account" },
				{ "include": "#amount" }
			]
		},
		"account": {
			"name": "entity.name.type.account.fin",
			"match": "\\b(Assets|Liabilities|Equity|Income|Expenses)((?::[\\p{L}\\p{N}]+)*)",
			"captures": {
				"1": { "name": "support.class.account-type.fin" },
				"2": {
					"patterns": [
						{
							"name": "punctuation.separator.account.fin",
							"match": ":"
						}
					]
				}
			}
		},
		"amount": {
			"match": "(-?\\d+(?:\\.\\d+)?)[ \\t]+([\\p{L}\\p{N}]+)",
			"captures": {
				"1": { "name": "constant.numeric.fin" },
				"2": { "name": "support.type.commodity.fin" }
			}
		},
		"commodity": {
			"name": "support.type.commodity.fin",
			"match": "[\\p{L}\\p{N}]+"
		},
		"date": {
			"name": "constant.numeric.date.fin",
			"match": "\\d{4}-\\d{2}-\\d{2}"
		},
		"string": {
			"name": "string.quoted.double.fin",
			"begin": "\"",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.string.begin.fin" }
			},
			"end": "\"",
			"endCaptures": {
				"0": { "name": "punctuation.definition.string.end.fin" }
			}
		}
	}
}
