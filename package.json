{
    "name": "language-knut",
    "displayName": "knut syntax support",
    "description": "Syntax support for the knut plain-text accounting system",
    "publisher": "sboehler",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/sboehler/language-knut"
    },
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "knut",
                "aliases": [
                    "knut"
                ],
                "extensions": [
                    ".knut",
                    ".fin"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "knut",
                "scopeName": "source.knut",
                "path": "./syntaxes/knut.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:knut"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack --config ./build/node-extension.webpack.config.js",
        "watch": "webpack --watch --config ./build/node-extension.webpack.config.js",
        "package": "webpack --mode production --devtool hidden-source-map --config ./build/node-extension.webpack.config.js",
        "compile-tests": "tsc -p ./",
        "watch-tests": "tsc -watch -p ./",
        "pretest": "npm run compile-tests && npm run lint",
        "lint": "eslint src",
        "test:grammar": "vscode-tmgrammar-snap --scope source.knut -g syntaxes/knut.tmLanguage.json \"syntaxes/tests/*.knut\"",
        "test": "npm run test:grammar && vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.9.2",
        "@types/vscode": "^1.90.0",
        "@typescript-eslint/eslint-plugin": "^8.46.0",
        "@typescript-eslint/parser": "^8.46.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "eslint": "^10.11.0",
        "mocha": "^12.0.2",
        "ts-loader": "^9.6.2",
        "typescript": "^5.9.3",
        "vscode-tmgrammar-test": "^0.1.3",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    },
    "overrides": {
        "mocha": "$mocha"
    }
}
