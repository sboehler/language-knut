{
    "name": "language-fin",
    "displayName": "fin syntax support",
    "description": "Syntax support for the fin plain-text accounting system",
    "publisher": "sboehler",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/sboehler/language-fin"
    },
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "fin",
                "aliases": [
                    "fin"
                ],
                "extensions": [
                    ".fin"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "configuration": {
            "title": "fin",
            "properties": {
                "fin.executable": {
                    "type": "string",
                    "default": "fin",
                    "markdownDescription": "The `fin` executable, used to check and format journals. A bare name is looked up on `PATH`."
                },
                "fin.journal": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "The root journal, as a path relative to the workspace folder. When set, journals are checked with `fin balance` over it, which also reports accounts booked to before they are opened and balance assertions that do not hold. When empty, only the edited file is checked, for syntax errors alone."
                },
                "fin.diagnostics.enable": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Report what `fin` finds in the journal, when a file is opened or saved."
                }
            }
        },
        "grammars": [
            {
                "language": "fin",
                "scopeName": "source.fin",
                "path": "./syntaxes/fin.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:fin"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack --config ./build/node-extension.webpack.config.js",
        "watch": "webpack --watch --config ./build/node-extension.webpack.config.js",
        "package": "webpack --mode production --devtool hidden-source-map --config ./build/node-extension.webpack.config.js",
        "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
        "compile-tests": "npm run clean && tsc -p ./",
        "watch-tests": "tsc -watch -p ./",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src",
        "test:grammar": "vscode-tmgrammar-snap --scope source.fin -g syntaxes/fin.tmLanguage.json \"syntaxes/tests/*.fin\"",
        "test": "npm run test:grammar && vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.9.2",
        "@types/vscode": "^1.90.0",
        "@typescript-eslint/eslint-plugin": "^8.46.0",
        "@typescript-eslint/parser": "^8.46.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "eslint": "^10.11.0",
        "mocha": "^12.0.2",
        "ts-loader": "^9.6.2",
        "typescript": "^5.9.3",
        "vscode-tmgrammar-test": "^0.1.3",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    },
    "overrides": {
        "mocha": "$mocha"
    }
}
